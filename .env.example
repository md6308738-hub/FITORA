# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais committer .env.local.

# Supabase : Project Settings → API (URL du projet et clé publique « publishable » ou « anon »).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (Project Settings → API Keys) : serveur uniquement, jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
